+                 << ", \"forest\": " << mesh.ForestIndex << ", \"tree\": " << mesh.TreeIndex
+                 << ", \"branch\": " << mesh.BranchIndex
+                 << ", \"uv_matrix\": " << mesh.UvMatrix << ", \"matrix_index\": " << mesh.MatrixIndex
+                 << ", \"matrix_indices\": [" << mesh.MatrixIndices[0] << ", " << mesh.MatrixIndices[1] << ", "
+                 << mesh.MatrixIndices[2] << ", " << mesh.MatrixIndices[3] << "]"
+                 << ", \"transform\": [" << mesh.Transform.PosU << ", " << mesh.Transform.PosV << ", " << mesh.Transform.Angle
+                 << ", " << mesh.Transform.ScaleU << ", " << mesh.Transform.ScaleV << "], \"colored\": "
+                 << (colored ? "true" : "false") << ", \"color_mean\": [" << sum[0] / n << ", " << sum[1] / n << ", "
+                 << sum[2] / n << ", " << sum[3] / n << "], \"alpha_min\": " << amin << ", \"vertices\": "
+                 << mesh.Vertices.size() << "}";
+            first = false;
+        }
+        info << "\n]}\n";
+    }
+
     std::cout << "Exported " << outputs.size() << " mesh chunks to " << outputPath << ".\n";
     return 0;
 }
